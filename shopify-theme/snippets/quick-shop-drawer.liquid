<div id="QuickShopDrawer" class="atelier-drawer">
  <div class="drawer-backdrop"></div>
  <div class="drawer-panel">
    <div style="padding: 24px; border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center;">
      <h3 class="micro-caps" style="font-size: 13px;">QUICK SHOP</h3>
      <button type="button" data-close-quick-shop style="font-size: 18px; color: var(--color-muted);">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <div style="padding: 24px; flex: 1; overflow-y: auto;">
      {% form 'product', product, id: 'QuickShopForm' %}
        <div style="display: flex; gap: 16px; margin-bottom: 24px;">
          <div style="width: 90px; height: 120px; background: var(--color-paper); overflow: hidden; flex-shrink: 0;">
            <img src="" alt="" data-qs-img style="width: 100%; height: 100%; object-fit: cover;">
          </div>
          <div>
            <span class="micro-caps text-muted" style="display: block; margin-bottom: 4px;">240 GSM &bull; STRUCTURED</span>
            <h4 data-qs-title style="font-size: 14px; text-transform: uppercase; font-weight: 600; margin-bottom: 6px;">Loading...</h4>
            <span data-qs-price style="font-family: monospace; font-size: 14px; font-weight: 600; color: var(--color-teal); display: block;">₹0</span>
          </div>
        </div>

        <input type="hidden" name="id" value="">
        <input type="hidden" name="quantity" value="1">

        <div style="margin-top: 32px; display: flex; flex-direction: column; gap: 12px;">
          <button type="submit" class="btn-primary" style="width: 100%;">
            ADD TO BAG
          </button>
          <a href="#" data-qs-details-link class="micro-caps" style="text-align: center; color: var(--color-muted); padding: 8px 0;">
            VIEW FULL DETAILS &rarr;
          </a>
        </div>
      {% endform %}
    </div>
  </div>
</div>
