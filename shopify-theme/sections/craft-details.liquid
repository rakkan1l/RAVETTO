<section class="craft-details-section" style="padding: 96px 0; background-color: var(--color-offwhite); border-bottom: 1px solid var(--color-border);">
  <div class="container-atelier">
    <!-- Header -->
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; margin-bottom: 50px; gap: 20px;">
      <div>
        <span class="micro-caps text-teal" style="display: block; margin-bottom: 8px;">The Architecture of Details</span>
        <h2 class="font-editorial" style="font-size: clamp(28px, 4vw, 44px); font-weight: 500;">Craftsmanship in Focus</h2>
      </div>
      <p class="micro-caps text-muted" style="max-width: 320px; line-height: 1.6;">
        Luxury lives in the millimeters you never consciously notice, but would immediately miss if absent.
      </p>
    </div>

    <!-- 6 Macro Modules Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 32px;">
      <!-- 01 Collar -->
      <div style="display: flex; flex-direction: column; gap: 12px;">
        <div style="position: relative; aspect-ratio: 4 / 5; background: var(--color-paper); overflow: hidden;">
          <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?auto=format&fit=crop&w=800&q=85" alt="Reinforced Collar" style="width: 100%; height: 100%; object-fit: cover;">
          <span style="position: absolute; top: 12px; left: 12px; background: rgba(255,255,255,0.9); padding: 2px 8px; font-size: 10px; font-family: monospace; font-weight: bold; color: var(--color-teal);">01</span>
        </div>
        <h3 class="micro-caps" style="color: var(--color-text);">01 / REINFORCED COLLAR</h3>
        <p style="font-size: 12px; color: var(--color-muted);">Designed to retain its shape.</p>
      </div>

      <!-- 02 Stitching -->
      <div style="display: flex; flex-direction: column; gap: 12px;">
        <div style="position: relative; aspect-ratio: 4 / 5; background: var(--color-paper); overflow: hidden;">
          <img src="https://images.unsplash.com/photo-1523381294911-8d3cead13475?auto=format&fit=crop&w=800&q=85" alt="Precision Stitching" style="width: 100%; height: 100%; object-fit: cover;">
          <span style="position: absolute; top: 12px; left: 12px; background: rgba(255,255,255,0.9); padding: 2px 8px; font-size: 10px; font-family: monospace; font-weight: bold; color: var(--color-teal);">02</span>
        </div>
        <h3 class="micro-caps" style="color: var(--color-text);">02 / PRECISION STITCHING</h3>
        <p style="font-size: 12px; color: var(--color-muted);">Clean construction with considered finishing.</p>
      </div>

      <!-- 03 Hem -->
      <div style="display: flex; flex-direction: column; gap: 12px;">
        <div style="position: relative; aspect-ratio: 4 / 5; background: var(--color-paper); overflow: hidden;">
          <img src="https://images.unsplash.com/photo-1583743814966-8936f5b7be1a?auto=format&fit=crop&w=800&q=85" alt="Structured Hem" style="width: 100%; height: 100%; object-fit: cover;">
          <span style="position: absolute; top: 12px; left: 12px; background: rgba(255,255,255,0.9); padding: 2px 8px; font-size: 10px; font-family: monospace; font-weight: bold; color: var(--color-teal);">03</span>
        </div>
        <h3 class="micro-caps" style="color: var(--color-text);">03 / STRUCTURED HEM</h3>
        <p style="font-size: 12px; color: var(--color-muted);">Built for repeated wear.</p>
      </div>

      <!-- 04 Seams -->
      <div style="display: flex; flex-direction: column; gap: 12px;">
        <div style="position: relative; aspect-ratio: 4 / 5; background: var(--color-paper); overflow: hidden;">
          <img src="https://images.unsplash.com/photo-1503342217505-b0a15ec3261c?auto=format&fit=crop&w=800&q=85" alt="Reinforced Seams" style="width: 100%; height: 100%; object-fit: cover;">
          <span style="position: absolute; top: 12px; left: 12px; background: rgba(255,255,255,0.9); padding: 2px 8px; font-size: 10px; font-family: monospace; font-weight: bold; color: var(--color-teal);">04</span>
        </div>
        <h3 class="micro-caps" style="color: var(--color-text);">04 / REINFORCED SEAMS</h3>
        <p style="font-size: 12px; color: var(--color-muted);">Bound flatlock interior seams without friction.</p>
      </div>

      <!-- 05 Fabric -->
      <div style="display: flex; flex-direction: column; gap: 12px;">
        <div style="position: relative; aspect-ratio: 4 / 5; background: var(--color-paper); overflow: hidden;">
          <img src="https://images.unsplash.com/photo-1598033129183-c4f50c736f10?auto=format&fit=crop&w=800&q=85" alt="Dense Fabric" style="width: 100%; height: 100%; object-fit: cover;">
          <span style="position: absolute; top: 12px; left: 12px; background: rgba(255,255,255,0.9); padding: 2px 8px; font-size: 10px; font-family: monospace; font-weight: bold; color: var(--color-teal);">05</span>
        </div>
        <h3 class="micro-caps" style="color: var(--color-text);">05 / DENSE FABRIC</h3>
        <p style="font-size: 12px; color: var(--color-muted);">240 GSM combed long-staple cotton knit.</p>
      </div>

      <!-- 06 Label -->
      <div style="display: flex; flex-direction: column; gap: 12px;">
        <div style="position: relative; aspect-ratio: 4 / 5; background: var(--color-paper); overflow: hidden;">
          <img src="https://images.unsplash.com/photo-1618354691373-d851c5c3a990?auto=format&fit=crop&w=800&q=85" alt="Atelier Label" style="width: 100%; height: 100%; object-fit: cover;">
          <span style="position: absolute; top: 12px; left: 12px; background: rgba(255,255,255,0.9); padding: 2px 8px; font-size: 10px; font-family: monospace; font-weight: bold; color: var(--color-teal);">06</span>
        </div>
        <h3 class="micro-caps" style="color: var(--color-text);">06 / ATELIER LABEL</h3>
        <p style="font-size: 12px; color: var(--color-muted);">Zero-friction heat-pressed interior stamp.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Craft Details",
  "settings": [],
  "presets": [
    {
      "name": "Craft Details"
    }
  ]
}
{% endschema %}
