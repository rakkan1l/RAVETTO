<section class="find-your-ravetto-section" style="padding: 96px 0; background-color: var(--color-offwhite-paper); border-bottom: 1px solid var(--color-border);">
  <div class="container-atelier">
    <!-- Header -->
    <div style="text-align: center; max-width: 600px; margin: 0 auto 50px auto;">
      <span class="micro-caps text-teal" style="display: block; margin-bottom: 8px;">Comparative Matrix</span>
      <h2 class="font-editorial" style="font-size: clamp(28px, 4vw, 44px); font-weight: 500; margin-bottom: 8px;">
        FIND YOUR RAVETTO
      </h2>
      <p class="micro-caps text-muted">
        Select the exact weight and silhouette engineered for your cadence
      </p>
    </div>

    <!-- Clean Editorial Matrix Table -->
    <div style="overflow-x: auto; background: var(--color-offwhite); border: 1px solid var(--color-border); box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
      <table style="width: 100%; border-collapse: collapse; text-align: left; min-width: 680px;">
        <thead>
          <tr style="border-bottom: 1px solid var(--color-border); background: var(--color-offwhite-paper);">
            <th class="micro-caps" style="padding: 16px 20px;">Dimension</th>
            <th style="padding: 16px 20px; font-weight: 600; font-size: 13px;">The Essential Tee</th>
            <th style="padding: 16px 20px; font-weight: 600; font-size: 13px;">Heavyweight Oversized</th>
            <th style="padding: 16px 20px; font-weight: 600; font-size: 13px;">Structured Mock Neck</th>
          </tr>
        </thead>
        <tbody style="font-size: 13px;">
          <!-- GSM -->
          <tr style="border-bottom: 1px solid var(--color-border);">
            <td class="micro-caps text-muted" style="padding: 16px 20px;">GSM</td>
            <td style="padding: 16px 20px; font-family: monospace; font-weight: bold; color: var(--color-teal);">240 GSM</td>
            <td style="padding: 16px 20px; font-family: monospace; font-weight: bold; color: var(--color-teal);">280 GSM</td>
            <td style="padding: 16px 20px; font-family: monospace; font-weight: bold; color: var(--color-teal);">260 GSM</td>
          </tr>

          <!-- FIT -->
          <tr style="border-bottom: 1px solid var(--color-border);">
            <td class="micro-caps text-muted" style="padding: 16px 20px;">FIT</td>
            <td style="padding: 16px 20px; font-weight: 500;">Structured Regular</td>
            <td style="padding: 16px 20px; font-weight: 500;">Architectural Drop-Shoulder</td>
            <td style="padding: 16px 20px; font-weight: 500;">Tailored Form</td>
          </tr>

          <!-- WEIGHT -->
          <tr style="border-bottom: 1px solid var(--color-border);">
            <td class="micro-caps text-muted" style="padding: 16px 20px;">WEIGHT</td>
            <td style="padding: 16px 20px; color: var(--color-muted);">Medium-Heavy</td>
            <td style="padding: 16px 20px; color: var(--color-muted);">Substantial Heavy</td>
            <td style="padding: 16px 20px; color: var(--color-muted);">Medium-Heavy</td>
          </tr>

          <!-- FEEL -->
          <tr style="border-bottom: 1px solid var(--color-border);">
            <td class="micro-caps text-muted" style="padding: 16px 20px;">FEEL</td>
            <td style="padding: 16px 20px; color: var(--color-muted);">Smooth, dense, combed Supima</td>
            <td style="padding: 16px 20px; color: var(--color-muted);">Velvety carbon-washed interlock</td>
            <td style="padding: 16px 20px; color: var(--color-muted);">Silken bio-polished cotton</td>
          </tr>

          <!-- STRUCTURE -->
          <tr style="border-bottom: 1px solid var(--color-border);">
            <td class="micro-caps text-muted" style="padding: 16px 20px;">STRUCTURE</td>
            <td style="padding: 16px 20px;">High shape retention</td>
            <td style="padding: 16px 20px;">Rigid architectural drape</td>
            <td style="padding: 16px 20px;">Firm upright collar line</td>
          </tr>

          <!-- BEST FOR -->
          <tr style="border-bottom: 1px solid var(--color-border);">
            <td class="micro-caps text-muted" style="padding: 16px 20px;">BEST FOR</td>
            <td style="padding: 16px 20px; color: var(--color-muted);">Daily foundational uniform</td>
            <td style="padding: 16px 20px; color: var(--color-muted);">Statement outerwear layer</td>
            <td style="padding: 16px 20px; color: var(--color-muted);">Transitional tailoring</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Find Your Ravetto",
  "settings": [],
  "presets": [
    {
      "name": "Find Your Ravetto"
    }
  ]
}
{% endschema %}
