<div id="CartDrawer" class="atelier-drawer">
  <div class="drawer-backdrop"></div>
  <div class="drawer-panel">
    <!-- Header -->
    <div style="padding: 24px; border-bottom: 1px solid var(--color-border); display: flex; align-items: center; justify-content: space-between;">
      <div>
        <h3 class="micro-caps" style="font-size: 13px; letter-spacing: 0.2em; color: var(--color-text);">
          {{ 'sections.cart.title' | t | default: 'YOUR BAG' }}
        </h3>
        <span style="font-family: monospace; font-size: 11px; color: var(--color-muted);">
          [{{ cart.item_count }} {{ 'sections.header.cart_count' | t: count: cart.item_count }}]
        </span>
      </div>
      <button type="button" data-close-cart style="font-size: 18px; color: var(--color-muted); padding: 4px;" aria-label="Close">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    {% if cart.item_count == 0 %}
      <!-- Empty State -->
      <div style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 40px 24px;">
        <div style="width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--color-border); display: flex; align-items: center; justify-content: center; margin-bottom: 16px; color: var(--color-muted);">
          <span class="font-editorial" style="font-style: italic; font-size: 18px;">rv</span>
        </div>
        <h4 class="micro-caps" style="font-size: 13px; color: var(--color-text); margin-bottom: 6px;">
          {{ 'sections.cart.empty' | t | default: 'YOUR BAG IS QUIET.' }}
        </h4>
        <p style="font-size: 12px; color: var(--color-muted); margin-bottom: 24px;">
          {{ 'sections.cart.empty_subtext' | t | default: 'Discover the collection.' }}
        </p>
        <a href="/collections/all" class="btn-primary" data-close-cart>
          {{ 'sections.cart.continue_shopping' | t | default: 'DISCOVER THE COLLECTION' }}
        </a>
      </div>
    {% else %}
      <!-- Complimentary Shipping Progress -->
      {% assign threshold = settings.free_shipping_threshold | default: 2500 | times: 100 %}
      <div style="padding: 16px 24px; border-bottom: 1px solid var(--color-border); background: var(--color-offwhite-paper);">
        <div style="display: flex; justify-content: space-between; font-size: 11px; text-transform: uppercase; letter-spacing: 0.14em; font-weight: 600; margin-bottom: 6px;">
          {% if cart.total_price >= threshold %}
            <span style="color: var(--color-teal);">COMPLIMENTARY SHIPPING UNLOCKED</span>
            <span>100%</span>
          {% else %}
            {% assign diff = threshold | minus: cart.total_price %}
            <span>{{ diff | money }} AWAY FROM COMPLIMENTARY SHIPPING</span>
            {% assign progress = cart.total_price | times: 100 | divided_by: threshold %}
            <span>{{ progress }}%</span>
          {% endif %}
        </div>
        <div style="width: 100%; height: 2px; background: rgba(226, 223, 214, 0.6); overflow: hidden;">
          <div style="height: 100%; background: var(--color-teal); width: {% if cart.total_price >= threshold %}100%{% else %}{{ cart.total_price | times: 100 | divided_by: threshold }}%{% endif %};"></div>
        </div>
      </div>

      <!-- Items List -->
      <div style="flex: 1; overflow-y: auto; padding: 20px 24px; display: flex; flex-direction: column; gap: 16px;">
        {% for item in cart.items %}
          <div style="display: flex; gap: 14px; border-bottom: 1px solid rgba(226, 223, 214, 0.5); padding-bottom: 16px;">
            <div style="width: 72px; height: 96px; background: var(--color-paper); flex-shrink: 0; overflow: hidden;">
              <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title }}" style="width: 100%; height: 100%; object-fit: cover;">
            </div>
            <div style="flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
              <div>
                <h4 style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.12em; font-weight: 600; margin-bottom: 2px;">
                  {{ item.product.title }}
                </h4>
                <p style="font-size: 11px; color: var(--color-muted);">
                  {{ item.variant.title }}
                </p>
                <span style="font-family: monospace; font-size: 12px; font-weight: 600; color: var(--color-teal); margin-top: 4px; display: block;">
                  {{ item.final_line_price | money }}
                </span>
              </div>
              <div style="display: flex; align-items: center; justify-content: space-between;">
                <span style="font-size: 11px; color: var(--color-muted);">Qty: {{ item.quantity }}</span>
                <a href="/cart/change?line={{ forloop.index }}&quantity=0" style="font-size: 11px; color: var(--color-muted);" aria-label="Remove item">
                  <i class="fa-regular fa-trash-can"></i>
                </a>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      <!-- Footer / Checkout -->
      <div style="padding: 24px; border-top: 1px solid var(--color-border); display: flex; flex-direction: column; gap: 12px; background: var(--color-offwhite);">
        <div style="display: flex; justify-content: space-between; font-size: 12px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--color-muted);">
          <span>Subtotal</span>
          <span style="font-family: monospace; font-weight: 600; color: var(--color-text);">{{ cart.total_price | money }}</span>
        </div>
        <a href="/checkout" class="btn-primary" style="width: 100%; text-align: center;">
          CHECKOUT &bull; {{ cart.total_price | money }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": []
}
{% endschema %}
