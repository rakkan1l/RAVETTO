<section class="collection-page-section" style="padding: 70px 0 110px 0; background-color: var(--color-offwhite);">
  <div class="container-atelier">
    <!-- Collection Header -->
    <div style="margin-bottom: 50px; text-align: left; border-bottom: 1px solid var(--color-border); padding-bottom: 24px;">
      <span class="micro-caps text-teal" style="display: block; margin-bottom: 6px;">Permanent Line</span>
      <div style="display: flex; justify-content: space-between; align-items: flex-end;">
        <h1 class="font-editorial" style="font-size: clamp(32px, 5vw, 50px); font-weight: 500; text-transform: uppercase;">
          {{ collection.title | default: 'All Pieces' }}
        </h1>
        <span style="font-family: monospace; font-size: 11px; color: var(--color-muted);">
          [{{ collection.products_count }} Pieces]
        </span>
      </div>
    </div>

    <!-- Product Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 36px 24px;">
      {% for product in collection.products %}
        {% render 'product-card', product: product %}
      {% else %}
        <div style="grid-column: 1 / -1; text-align: center; padding: 80px 0;">
          <p class="micro-caps text-muted">No garments found in this curation.</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Grid",
  "settings": []
}
{% endschema %}
