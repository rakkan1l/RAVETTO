<section style="padding: 80px 20px; background: var(--color-offwhite);">
  <div class="container-atelier" style="max-width: 860px;">
    <div style="border-bottom: 1px solid var(--color-border); padding-bottom: 20px; margin-bottom: 40px;">
      <h1 class="font-editorial" style="font-size: clamp(28px, 4vw, 44px); text-transform: uppercase;">
        {{ page.title }}
      </h1>
    </div>
    <div style="font-size: 14px; line-height: 1.8; color: var(--color-text);">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page Content",
  "settings": []
}
{% endschema %}
