<header class="atelier-header">
  <div class="container-atelier header-inner">
    <!-- Left: Navigation Links with Mega Menu -->
    <nav class="nav-links">
      <div class="shop-menu-item">
        <a href="/collections/all" class="nav-link">Shop</a>
        <div class="shop-mega-menu">
          <div class="mega-menu-list">
            <span class="mega-menu-title">Collections</span>
            <a href="/collections/all?sort_by=created-descending" class="mega-link">NEW ARRIVALS</a>
            <a href="/collections/the-foundations" class="mega-link">ESSENTIAL TEES</a>
            <a href="/collections/heavyweight-atelier" class="mega-link">HEAVYWEIGHT</a>
            <a href="/collections/all" class="mega-link">RELAXED FIT</a>
            <a href="/collections/all" class="mega-link">SHOP ALL</a>
          </div>
          <div class="mega-menu-image" style="position: relative; overflow: hidden; background: #EFECE4;">
            <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?auto=format&fit=crop&w=600&q=80" alt="SS26 Campaign" style="width: 100%; height: 100%; object-fit: cover;">
            <div style="position: absolute; bottom: 12px; left: 12px; color: #fff;">
              <span style="font-size: 9px; text-transform: uppercase; letter-spacing: 0.2em; display: block;">SS26 Campaign</span>
              <span style="font-family: var(--font-editorial); font-size: 13px;">Timeless Proportions</span>
            </div>
          </div>
        </div>
      </div>
      <a href="/collections" class="nav-link">Collections</a>
      <a href="/pages/materials" class="nav-link">Materials</a>
      <a href="/pages/craft" class="nav-link">Craft</a>
      <a href="/blogs/journal" class="nav-link">Journal</a>
    </nav>

    <!-- Center: Brand Logo -->
    <div class="header-logo">
      <a href="/" class="brand-logo">{{ shop.name | default: 'RAVETTO' }}</a>
    </div>

    <!-- Right: Actions -->
    <div class="header-actions">
      <!-- Search Trigger (CMD+K) -->
      <button type="button" class="action-btn" data-open-search aria-label="Search">
        <i class="fa-solid fa-magnifying-glass" style="font-size: 13px;"></i>
        <span style="font-size: 10px; font-family: monospace; color: var(--color-muted);" class="hidden-mobile">⌘K</span>
      </button>

      <!-- Account -->
      {%- if shop.customer_accounts_enabled -%}
        <a href="{%- if customer -%}/account{%- else -%}/account/login{%- endif -%}" class="action-btn" aria-label="Account">
          <i class="fa-regular fa-user" style="font-size: 14px;"></i>
        </a>
      {%- endif -%}

      <!-- Cart Drawer Trigger -->
      <button type="button" class="action-btn" data-open-cart aria-label="Cart">
        <i class="fa-solid fa-bag-shopping" style="font-size: 14px; color: var(--color-teal);"></i>
        <span style="font-size: 11px; font-family: monospace; font-weight: 600; color: var(--color-teal);">
          [{{ cart.item_count }}]
        </span>
      </button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
