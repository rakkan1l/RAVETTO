<section class="product-page-section" style="padding: 60px 0 100px 0; background-color: var(--color-offwhite);">
  <div class="container-atelier">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 60px;">
      <!-- Left: Product Gallery Stack -->
      <div style="display: flex; flex-direction: column; gap: 16px;">
        {% for image in product.images %}
          <div style="position: relative; aspect-ratio: 3 / 4; background: var(--color-paper); border: 1px solid var(--color-border); overflow: hidden;">
            <img src="{{ image | image_url: width: 1200 }}" alt="{{ image.alt | default: product.title }}" style="width: 100%; height: 100%; object-fit: cover;" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
          </div>
        {% endfor %}
      </div>

      <!-- Right: Sticky Product Story & Purchase Form -->
      <div style="position: sticky; top: 100px; height: fit-content; display: flex; flex-direction: column; gap: 24px;">
        <div>
          <span class="micro-caps text-teal" style="display: block; margin-bottom: 6px;">240 GSM &bull; STRUCTURED REGULAR</span>
          <h1 class="font-editorial" style="font-size: clamp(26px, 3.5vw, 40px); font-weight: 500; text-transform: uppercase; margin-bottom: 10px;">
            {{ product.title }}
          </h1>
          <span style="font-family: monospace; font-size: 18px; font-weight: 600; color: var(--color-teal); display: block;">
            {{ product.price | money }}
          </span>
        </div>

        <div style="font-size: 13px; color: var(--color-muted); line-height: 1.6; border-top: 1px solid var(--color-border); padding-top: 16px;">
          {{ product.description }}
        </div>

        {% form 'product', product %}
          <!-- Size Selector & Guide Trigger -->
          <div style="margin-bottom: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
              <span class="micro-caps" style="color: var(--color-text);">Select Size</span>
              <button type="button" onclick="document.getElementById('SizeGuideDrawer').classList.add('is-open')" class="micro-caps text-teal" style="text-decoration: underline;">
                FIND YOUR SIZE
              </button>
            </div>

            <select name="id" style="width: 100%; padding: 12px 14px; border: 1px solid var(--color-border); background: var(--color-offwhite-paper); font-size: 12px; text-transform: uppercase; outline: none;">
              {% for variant in product.variants %}
                <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>
                  {{ variant.title }} &bull; {{ variant.price | money }}
                </option>
              {% endfor %}
            </select>
          </div>

          <!-- Add to Cart CTA -->
          <button type="submit" name="add" data-main-add-to-cart class="btn-primary" style="width: 100%; padding: 16px 0; font-size: 12px;">
            {{ 'products.product.add_to_cart' | t | default: 'ADD TO BAG' }}
          </button>
        {% endform %}

        <div style="display: flex; flex-direction: column; gap: 8px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--color-muted); padding-top: 16px; border-top: 1px solid var(--color-border);">
          <span>&bull; 100% Combed Long-Staple Cotton</span>
          <span>&bull; Pre-Shrunk Bio-Polish Finish</span>
          <span>&bull; 14-Day Quiet Returns</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Sticky Mobile Add to Bag Bar -->
  <div id="StickyMobileBuyBar" class="sticky-mobile-buy-bar" style="display: none;">
    <div style="text-align: left;">
      <h4 style="font-size: 11px; text-transform: uppercase; font-weight: 600; letter-spacing: 0.1em;">{{ product.title }}</h4>
      <span style="font-family: monospace; font-size: 11px; color: var(--color-teal); font-weight: 600;">{{ product.price | money }}</span>
    </div>
    <button type="button" onclick="document.querySelector('[data-main-add-to-cart]')?.click()" class="btn-primary" style="padding: 10px 18px; font-size: 10px;">
      ADD TO BAG
    </button>
  </div>
</section>

{% schema %}
{
  "name": "Product Information",
  "settings": []
}
{% endschema %}
